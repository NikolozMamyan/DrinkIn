{% extends 'base.html.twig' %}

{% block title %}DrinkIn | Connexion{% endblock %}

{% block body %}
<main class="auth-shell">
    <div class="auth-wrapper">

        <div class="auth-brand">
            <div class="auth-logo-icon">
                <i class="fa-solid fa-wine-glass"></i>
            </div>
            <p class="auth-logo-text">Drink<em>In</em></p>
            <p class="auth-tagline">Votre cave mobile de poche</p>
        </div>

        <section class="auth-card" id="auth-card">
            <p class="section-eyebrow">Connexion securisee</p>
            <h1 class="auth-card-title">Accedez a votre cave</h1>

            {% if error %}
                <div class="auth-flash">
                    <i class="fa-solid fa-circle-xmark"></i>
                    <span>{{ error }}</span>
                </div>
            {% endif %}

            <form method="post" class="auth-form" id="auth-form">
                <div class="auth-field">
                    <div class="auth-input-wrap">
                        <i class="fa-solid fa-envelope auth-field-icon"></i>
                        <input
                            type="email"
                            name="_username"
                            value="{{ last_username }}"
                            class="form-input auth-input"
                            placeholder="Adresse email"
                            autocomplete="email"
                            required
                        >
                    </div>
                </div>

                <div class="auth-field">
                    <div class="auth-input-wrap">
                        <i class="fa-solid fa-lock auth-field-icon"></i>
                        <input
                            type="password"
                            name="_password"
                            id="auth-pw"
                            class="form-input auth-input auth-input-pw"
                            placeholder="Mot de passe"
                            autocomplete="current-password"
                            required
                        >
                        <button type="button" class="auth-eye-btn" aria-label="Afficher le mot de passe">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <label class="checkbox-row">
                    <input type="checkbox" name="_remember_me" checked>
                    <span>Rester connecte sur cet appareil</span>
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary btn-full auth-submit-btn" type="submit">
                    <span class="auth-btn-text">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        Se connecter
                    </span>
                    <span class="auth-spinner" hidden aria-hidden="true">
                        <i class="fa-solid fa-circle-notch fa-spin"></i>
                        Connexion en cours...
                    </span>
                </button>
            </form>

            <div class="auth-divider"><span>Nouveau sur DrinkIn ?</span></div>
            <a href="{{ path('app_register') }}" class="btn btn-outline btn-full">
                <i class="fa-solid fa-user-plus"></i>
                Creer mon compte
            </a>
        </section>
    </div>
</main>

<script>
(function () {
    var card = document.getElementById('auth-card');
    var form = document.getElementById('auth-form');

    // Shake on error
    if (document.querySelector('.auth-flash') && card) {
        card.classList.add('auth-shake');
        card.addEventListener('animationend', function () {
            card.classList.remove('auth-shake');
        }, { once: true });
    }

    // Spinner on submit
    if (form) {
        form.addEventListener('submit', function () {
            var btn = form.querySelector('.auth-submit-btn');
            if (!btn) return;
            btn.querySelector('.auth-btn-text').hidden = true;
            btn.querySelector('.auth-spinner').hidden = false;
            btn.disabled = true;
        });
    }

    // Password toggle
    var eyeBtn = document.querySelector('.auth-eye-btn');
    var pwInput = document.getElementById('auth-pw');
    if (eyeBtn && pwInput) {
        eyeBtn.addEventListener('click', function () {
            var isPassword = pwInput.type === 'password';
            pwInput.type = isPassword ? 'text' : 'password';
            var icon = eyeBtn.querySelector('i');
            icon.classList.toggle('fa-eye', !isPassword);
            icon.classList.toggle('fa-eye-slash', isPassword);
        });
    }
})();
</script>
{% endblock %}
