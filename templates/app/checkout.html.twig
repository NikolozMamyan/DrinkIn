{% extends 'layouts/app.html.twig' %}

{% block title %}DrinkIn | Paiement{% endblock %}

{% block app_header %}
    <header class="header">
        <div class="header-title">
            <a href="{{ path('app_cart') }}" class="icon-btn"><i class="fa-solid fa-arrow-left"></i></a>
            <span>Paiement</span>
        </div>
        <div class="small-copy"><i class="fa-solid fa-lock"></i> SSL securise</div>
    </header>
{% endblock %}

{% block app_body %}
    <div
        data-controller="checkout"
        data-checkout-checkout-url-value="{{ path('api_orders_checkout') }}"
        data-checkout-guest-account-url-value="{{ path('api_orders_guest_account') }}"
        data-checkout-authenticated-value="{{ is_authenticated ? 'true' : 'false' }}"
        data-checkout-delivery-mode-value="{{ cart.delivery }}"
        data-checkout-has-saved-address-value="{{ profile.addresses|length > 0 ? 'true' : 'false' }}"
    >
        <main class="page" data-checkout-target="main">
            <div class="steps">
                <div class="step done"><div class="step-dot"><i class="fa-solid fa-check"></i></div><div class="step-label">Panier</div></div>
                <div class="step done"><div class="step-dot"><i class="fa-solid fa-check"></i></div><div class="step-label">Livraison</div></div>
                <div class="step active"><div class="step-dot">3</div><div class="step-label">Paiement</div></div>
            </div>

            <div class="utility-stack">
                {% if not is_authenticated %}
                    <section class="checkout-panel">
                        <div class="section-header"><h2>Commander en invite</h2></div>
                        <div class="form-stack">
                            <div class="input-row">
                                <input class="form-input" type="text" placeholder="Prenom" data-checkout-target="guestFirstName">
                                <input class="form-input" type="text" placeholder="Nom" data-checkout-target="guestLastName">
                            </div>
                            <input class="form-input" type="email" placeholder="Email" data-checkout-target="guestEmail">
                            <input class="form-input" type="text" placeholder="Telephone (optionnel)" data-checkout-target="guestPhone">
                            {% if cart.delivery != 'pickup' %}
                                <input class="form-input" type="text" placeholder="Adresse" data-checkout-target="guestStreet">
                                <div class="input-row">
                                    <input class="form-input" type="text" placeholder="Code postal" data-checkout-target="guestPostalCode">
                                    <input class="form-input" type="text" placeholder="Ville" data-checkout-target="guestCity">
                                </div>
                                <input class="form-input" type="text" placeholder="Pays" value="FR" data-checkout-target="guestCountryCode">
                            {% else %}
                                <div class="pickup-inline-note">
                                    <i class="fa-solid fa-store"></i>
                                    <span>Aucune adresse de livraison necessaire pour un retrait en magasin.</span>
                                </div>
                            {% endif %}
                        </div>
                    </section>
                {% endif %}

                <section class="checkout-panel">
                    <div class="section-header"><h2>Adresse de livraison</h2></div>
                    {% if cart.delivery == 'pickup' %}
                        <div class="address-card address-card-store">
                            <div class="address-card-store-icon"><i class="fa-solid fa-store"></i></div>
                            <div>
                                <p class="card-name">{{ store_address.label }}</p>
                                <p class="card-sub">{{ store_address.address }}</p>
                                <p class="small-copy">{{ store_address.hours }}</p>
                            </div>
                        </div>
                    {% else %}
                        {% for address in profile.addresses %}
                            {% include 'partials/_address_card.html.twig' with { address: address } %}
                        {% endfor %}
                        {% if is_authenticated and profile.addresses|length == 0 %}
                            <a href="{{ path('app_profile') }}" class="address-plus-card">
                                <span class="address-plus-symbol">+</span>
                                <span class="address-plus-copy">
                                    <strong>Ajouter une adresse</strong>
                                    <span>Impossible de confirmer la commande sans adresse de livraison.</span>
                                </span>
                            </a>
                        {% elseif profile.addresses|length == 0 %}
                            <div class="address-card address-card-warning">
                                <div>
                                    <p class="card-name">Adresse requise</p>
                                    <p class="card-sub">Renseignez votre adresse dans le formulaire invite pour continuer.</p>
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
                </section>

                <section class="checkout-panel">
                    <div class="section-header"><h2>Moyen de paiement</h2></div>
                    <div class="pay-methods">
                        <button type="button" class="pay-method active"><i class="fa-regular fa-credit-card"></i>Carte</button>
                        <button type="button" class="pay-method"><i class="fa-brands fa-paypal"></i>PayPal</button>
                        <button type="button" class="pay-method"><i class="fa-brands fa-apple-pay"></i>Apple</button>
                    </div>
                </section>

                <section class="card-3d">
                    <div class="card-inner" data-checkout-target="cardInner">
                        <div class="card-front stripe-card">
                            <div class="small-copy">Carte premium</div>
                            <div class="card-number" data-checkout-target="numberDisplay">•••• •••• •••• ••••</div>
                            <div class="card-meta">
                                <div><div class="small-copy">Titulaire</div><div data-checkout-target="nameDisplay">VOTRE NOM</div></div>
                                <div><div class="small-copy">Expire</div><div data-checkout-target="expiryDisplay">MM/AA</div></div>
                            </div>
                        </div>
                        <div class="card-back">
                            <div class="card-back-strip"></div>
                            <div class="card-back-body">
                                <div class="summary-row"><span>CVV</span><span data-checkout-target="cvvDisplay">•••</span></div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="form-stack checkout-form">
                    <input class="form-input" type="text" placeholder="Numero de carte" data-action="input->checkout#formatNumber">
                    <input class="form-input" type="text" placeholder="Titulaire" data-action="input->checkout#updateName">
                    <div class="input-row">
                        <input class="form-input" type="text" placeholder="MM/AA" data-action="input->checkout#formatExpiry">
                        <input class="form-input" type="text" placeholder="CVV" data-action="focus->checkout#flip blur->checkout#unflip input->checkout#updateCvv">
                    </div>
                </section>

                <section class="summary-box checkout-summary">
                    <div class="summary-row"><span>{{ cart.count }} articles</span><span>{{ (cart.subtotal / 100)|number_format(2, ',', ' ') }}EUR</span></div>
                    <div class="summary-row"><span>Livraison</span><span>{{ (cart.deliveryFee / 100)|number_format(2, ',', ' ') }}EUR</span></div>
                    <div class="summary-row total"><span>Total</span><span>{{ (cart.total / 100)|number_format(2, ',', ' ') }}EUR</span></div>
                </section>

                <button type="button" class="btn btn-primary btn-full checkout-pay-button" data-checkout-target="payButton" data-action="click->checkout#openModal">
                    <i class="fa-solid fa-lock"></i> Payer {{ (cart.total / 100)|number_format(2, ',', ' ') }}EUR
                </button>
            </div>
        </main>

        <section class="modal-overlay" data-checkout-target="modal">
            <div class="modal-sheet">
                <div class="modal-handle"></div>
                <div data-checkout-target="processing">
                    <p class="section-title">Verification 3D Secure...</p>
                </div>
                <div data-checkout-target="otp" hidden>
                    <p class="section-title">Confirmez votre paiement</p>
                    <p class="small-copy">Code envoye au 06 •• •••• •••• 42</p>
                    <div class="input-row otp-grid">
                        <input class="form-input" maxlength="1">
                        <input class="form-input" maxlength="1">
                        <input class="form-input" maxlength="1">
                    </div>
                    <button type="button" class="btn btn-primary btn-full" data-action="click->checkout#confirm">Confirmer</button>
                </div>
            </div>
        </section>

        <section class="page" data-checkout-target="success" hidden>
            <div class="utility-stack">
                <div class="summary-box checkout-success-card">
                    <h2 class="section-title">Commande confirmee</h2>
                    <p class="small-copy">Numero <span data-checkout-target="successNumber">DRK-00000000</span></p>
                    <p class="small-copy">Livraison estimee : 30 a 45 min</p>
                    <div class="divider"></div>
                    <div class="summary-row"><span>Total paye</span><span>{{ (cart.total / 100)|number_format(2, ',', ' ') }}EUR</span></div>
                </div>
                {% if not is_authenticated %}
                    <section class="checkout-panel" data-checkout-target="guestAccountPanel" hidden>
                        <div class="section-header"><h2>Creer votre compte</h2></div>
                        <p class="small-copy">Ajoutez un mot de passe pour retrouver cette commande et reutiliser vos informations la prochaine fois.</p>
                        <div class="form-stack">
                            <input class="form-input" type="password" placeholder="Mot de passe" data-checkout-target="guestPassword">
                            <button type="button" class="btn btn-primary btn-full" data-action="click->checkout#createGuestAccount">Creer mon compte</button>
                        </div>
                    </section>
                {% else %}
                    <a href="{{ path('app_orders') }}" class="btn btn-primary btn-full">Suivre ma commande</a>
                {% endif %}
                <a href="{{ path('app_home') }}" class="btn btn-outline btn-full">Continuer mes achats</a>
            </div>
        </section>
    </div>
{% endblock %}
